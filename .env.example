# =============================================
# PayNexus – Environment Configuration
# Copy to .env and fill in real values
# =============================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=paynexus
POSTGRES_USER=paynexus
POSTGRES_PASSWORD=paynexus_secret_change_me

# Full DSN (constructed automatically in docker-compose, override here if needed)
# DATABASE_URL=postgresql+asyncpg://paynexus:paynexus_secret@postgres:5432/paynexus

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API Key Auth ---
API_KEY_HEADER=X-API-Key

# --- Field-level Encryption (Fernet / AES-128-CBC+HMAC) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=generate_me_with_fernet_generate_key

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=30

# --- Seed ---
SEED_RANDOM_SEED=42
SEED_NUM_CUSTOMERS=200
SEED_NUM_PAYMENTS=5000

# --- Mock Service URLs ---
RAIL_UPI_URL=http://rail-upi-sim:8101
RAIL_NEFT_URL=http://rail-neft-sim:8102
RAIL_SWIFT_URL=http://rail-swift-sim:8103
RAIL_CARD_URL=http://rail-card-sim:8104
SANCTIONS_URL=http://sanctions-provider-sim:8201
KYC_URL=http://kyc-provider-sim:8202

# --- Observability ---
PROMETHEUS_METRICS_PATH=/metrics
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=300

# --- App ---
APP_ENV=development
APP_VERSION=1.0.0
APP_SECRET=app_secret_for_webhook_hmac_change_me

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin_change_me
GF_SECURITY_ADMIN_USER=admin
